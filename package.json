{
  "name": "ghost-hud",
  "private": true,
  "version": "1.0.0",
  "description": "Ghost — Floating Conversational Copilot HUD for real-time meeting intelligence",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "electron": "electron .",
    "start": "concurrently --kill-others-on-fail --names server,hud --prefix-colors cyan,magenta \"npm run dev\" \"npm run electron\"",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --outfile=server.cjs --external:vite",
    "build:mac": "npm run build && npm run build:server && electron-builder --mac dmg zip",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.ghosthud.app",
    "productName": "Ghost HUD",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "server.cjs",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Ghost HUD uses your microphone to provide live conversation transcriptions."
      },
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
